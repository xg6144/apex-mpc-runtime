+  // Rear motor braking at full lock can consume too much of the tyre's force
+  // budget.  Reduce it smoothly, but never change its sign.
+  const double steering_fraction = std::min(
+    1.0, std::abs(cmd.drive.steering_angle) / brake_steering_reference_);
