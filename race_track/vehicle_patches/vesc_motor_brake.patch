+
+bool AckermannToVesc::brakeRequested(
+  const AckermannDriveStamped & cmd, const double state_age) const
+{
+  if (!enable_motor_brake_ || !have_vesc_state_ || state_age > brake_state_timeout_) {
+    return false;
+  }
+  // This race stack only drives forward.  Refuse regenerative braking for a
+  // reverse/stale-sign command rather than applying an unvalidated torque.
+  if (cmd.drive.speed < 0.0 || measured_speed_ <= 0.0) {
+    return false;
+  }
+  const double voltage_limit = braking_ ?
+    brake_max_input_voltage_ : brake_resume_input_voltage_;
+  if (voltage_limit > 0.0 && input_voltage_ >= voltage_limit) {
+    return false;
+  }
+
+  const double speed_error = measured_speed_ - cmd.drive.speed;
+  if (!braking_) {
+    return cmd.drive.acceleration <= brake_accel_engage_ &&
+           measured_speed_ >= brake_min_speed_ &&
+           speed_error >= brake_speed_error_engage_;
+  }
+  return cmd.drive.acceleration <= brake_accel_release_ &&
+         measured_speed_ >= brake_release_speed_ &&
+         speed_error >= brake_speed_error_release_;
