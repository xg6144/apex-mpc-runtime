+
+double AckermannToVesc::brakeCurrent(
+  const AckermannDriveStamped & cmd, const double dt) const
+{
+  const double extra_deceleration = std::max(
+    0.0, -cmd.drive.acceleration - std::abs(brake_accel_engage_));
+  const double extra_speed_error = std::max(
+    0.0, measured_speed_ - cmd.drive.speed - brake_speed_error_engage_);
+  double target = brake_current_min_ +
+    brake_current_per_mps2_ * extra_deceleration +
+    brake_current_per_mps_ * extra_speed_error;
