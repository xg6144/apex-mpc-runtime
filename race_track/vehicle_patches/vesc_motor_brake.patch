+
+void AckermannToVesc::watchdogCallback()
+{
+  if (last_command_time_.nanoseconds() == 0) {
+    return;
+  }
+  if ((now() - last_command_time_).seconds() <= brake_command_timeout_) {
+    return;
+  }
+
+  // Override either a latched ERPM target or a latched current-brake target
+  // when the mux/controller stream disappears.  A zero-current brake packet
+  // selects coast without an abrupt rear-axle torque step; a later valid
+  // drive message selects speed mode or a freshly checked braking current.
+  Float64 release_msg;
+  release_msg.data = 0.0;
+  brake_pub_->publish(release_msg);
+  braking_ = false;
+  last_brake_current_ = 0.0;
+  last_motor_command_time_ = now();
+  last_command_time_ = rclcpp::Time(0, 0, RCL_ROS_TIME);
+  RCLCPP_WARN(get_logger(), "motor watchdog forced coast after stale command");
 }
 
