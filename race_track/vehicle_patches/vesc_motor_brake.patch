+void AckermannToVesc::vescStateCallback(const VescStateStamped::SharedPtr state)
+{
+  measured_speed_ =
+    (state->state.speed - speed_to_erpm_offset_) / vesc_state_speed_to_erpm_gain_;
+  input_voltage_ = state->state.voltage_input;
+  have_vesc_state_ = std::isfinite(measured_speed_) && std::isfinite(input_voltage_);
+  last_vesc_state_time_ = now();
